# TrickLogic2's release, for PortableKit's release scripts:
#   portablekit/scripts/release_macos.sh --game . <build>
#   portablekit/scripts/release_linux.sh --game .
# (see portablekit/docs/RELEASING.md).
RELEASE_NAME=TrickLogic2
RELEASE_SLUG=tricklogic2
RELEASE_TARGET=TrickLogic2Native
RELEASE_APP_ID=works.lm.TrickLogic2Native
RELEASE_OVERLAYS=0
RELEASE_MACOS_CATEGORY=public.app-category.adventure-games
# Names of the games' own files that must never be packed: the two discs'
# ids, the save and download folder, the save file, Season 1's built cases,
# disc images in CHD form and disc overlay patches.
RELEASE_GAME_NAMES="ucjs10105* ucjs-10105* ucjs10097* ucjs-10097* npjg00025* sn7save* *.edat *.chd *.pkpatch"
